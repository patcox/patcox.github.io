---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

function formatDate(d: Date) {
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
}

// Build sorted tag list with counts
const tagCounts = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags ?? []) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}
const allTags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---
<Base
  title="Writing — Pat Cox"
  description="Notes on AI, technology, and whatever else Pat Cox is thinking about."
>
  <div class="container">
    <header class="page-hero">
      <p class="section-label">Writing</p>
      <h1>Notes & essays</h1>
      <p>On AI, technology, and the things that matter.</p>
    </header>

    <section class="section">
      {posts.length === 0 ? (
        <p style="color:var(--text-muted);">Nothing here yet — check back soon.</p>
      ) : (
        <ul class="post-list">
          {posts.map(post => (
            <li class="post-card">
              <div>
                <a class="post-card-title" href={`/writing/${post.slug}`}>{post.data.title}</a>
                {post.data.description && (
                  <p class="post-card-desc">{post.data.description}</p>
                )}
              </div>
              <time class="post-card-date" datetime={post.data.pubDate.toISOString()}>
                {formatDate(post.data.pubDate)}
              </time>
            </li>
          ))}
        </ul>
      )}

      {allTags.length > 0 && (
        <details class="topics-accordion">
          <summary>Browse by topic</summary>
          <ul class="topics-list">
            {allTags.map(([tag, count]) => (
              <li>
                <span>
                  <a href={`/tags/${tag}`} class="topics-list-tag">
                    {tag.charAt(0).toUpperCase() + tag.slice(1)}
                  </a>
                  <span class="topics-list-tag-count">{count} post{count !== 1 ? 's' : ''}</span>
                </span>
                <div class="topics-list-actions">
                  <a href={`/tags/${tag}`} class="tag">{tag}</a>
                  <a href={`/tags/${tag}.xml`} class="rss-tag-link">RSS</a>
                </div>
              </li>
            ))}
          </ul>
        </details>
      )}
    </section>
  </div>
</Base>
