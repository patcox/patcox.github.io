---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

function formatDate(d: Date) {
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
}
---
<Base
  title="Writing — Pat Cox"
  description="Notes on AI, technology, and whatever else Pat Cox is thinking about."
>
  <div class="container">
    <header class="page-hero">
      <p class="section-label">Writing</p>
      <h1>Notes & essays</h1>
      <p>On AI, technology, and the things that matter.</p>
    </header>

    <section class="section">
      {posts.length === 0 ? (
        <p style="color:var(--text-muted);">Nothing here yet — check back soon.</p>
      ) : (
        <ul class="post-list">
          {posts.map(post => (
            <li class="post-card">
              <div>
                <a class="post-card-title" href={`/writing/${post.slug}`}>{post.data.title}</a>
                {post.data.description && (
                  <p class="post-card-desc">{post.data.description}</p>
                )}
              </div>
              <time class="post-card-date" datetime={post.data.pubDate.toISOString()}>
                {formatDate(post.data.pubDate)}
              </time>
            </li>
          ))}
        </ul>
      )}
    </section>
  </div>
</Base>
