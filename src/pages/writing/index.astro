---
import Base from '../../layouts/Base.astro';
import { getCollection, getEntry } from 'astro:content';
import { SITE } from '../../config/site.ts';

if (!SITE.showWriting) return Astro.redirect('/', 302);

const writing = await getEntry('pages', 'writing');
const { seo_title, seo_description, heading, description } = writing.data;

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

function formatDate(d: Date) {
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
}

const tagCounts = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags ?? []) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}
const allTags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---
<Base title={seo_title!} description={seo_description!}>
  <div class="container">
    <header class="page-header">
      <p class="section-label">Writing</p>
      <h1>{heading}</h1>
      <p>{description}</p>
    </header>

    <section class="section">
      {posts.length === 0 ? (
        <p style="color:var(--text-muted);">Nothing here yet — check back soon.</p>
      ) : (
        <ul class="post-list">
          {posts.map(post => (
            <li>
              <a class="post-card" href={`/writing/${post.slug}`}>
                <div>
                  <span class="post-card-title">{post.data.title}</span>
                  {post.data.description && (
                    <p class="post-card-desc">{post.data.description}</p>
                  )}
                </div>
                <time class="post-card-date" datetime={post.data.pubDate.toISOString()}>
                  {formatDate(post.data.pubDate)}
                </time>
              </a>
            </li>
          ))}
        </ul>
      )}

      {allTags.length > 0 && (
        <details class="topics-accordion">
          <summary>Browse by topic</summary>
          <ul class="topics-list">
            {allTags.map(([tag, count]) => (
              <li>
                <span>
                  <a href={`/tags/${tag}`} class="topics-list-tag">
                    {tag.charAt(0).toUpperCase() + tag.slice(1)}
                  </a>
                  <span class="topics-list-tag-count">{count} post{count !== 1 ? 's' : ''}</span>
                </span>
                <div class="topics-list-actions">
                  <a href={`/tags/${tag}`} class="tag">{tag}</a>
                  <a href={`/tags/${tag}.xml`} class="rss-tag-link">RSS</a>
                </div>
              </li>
            ))}
          </ul>
        </details>
      )}
    </section>
  </div>
</Base>
