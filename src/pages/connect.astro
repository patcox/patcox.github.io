---
import Base from '../layouts/Base.astro';
---
<Base
  title="Connect — Pat Cox"
  description="Book time with Pat Cox for a coffee, lunch, or a quick call."
>
  <div class="container">
    <header class="connect-intro">
      <p class="section-label">Connect</p>
      <h1>Let's get together.</h1>
      <p>
        I love meeting people. If you're curious about AI, want to talk tech, or just want to grab
        lunch — I'm genuinely up for it. Pick what works for you.
      </p>
    </header>
  </div>

  <!-- Schedule Cards -->
  <div class="container" id="schedule-cards">
    <div class="schedule-cards">

      <a
        href="https://cal.com/patcox/chat-with-pat"
        target="_blank"
        rel="noopener noreferrer"
        class="schedule-card"
      >
        <div class="schedule-card-icon">☕</div>
        <div class="schedule-card-title">Chat with Pat</div>
        <p class="schedule-card-desc">
          Book some time to chat. Grab a virtual or in-person coffee. Good for introductions,
          ideas, or just catching up.
        </p>
        <div class="schedule-card-meta">30 minutes · cal.com</div>
      </a>

      <a
        href="https://cal.com/patcox/lunch-with-pat"
        target="_blank"
        rel="noopener noreferrer"
        class="schedule-card"
      >
        <div class="schedule-card-icon">🍽️</div>
        <div class="schedule-card-title">Lunch with Pat</div>
        <p class="schedule-card-desc">
          Let's get lunch. I'm in Dripping Springs and happy to find a spot that works for both
          of us somewhere in the Hill Country.
        </p>
        <div class="schedule-card-meta">1 hour · cal.com</div>
      </a>

    </div>
  </div>

  <!-- Cal.com Inline Embed (toggle to show full picker) -->
  <div class="container" id="cal-embed-section" style="display:none;">
    <div class="cal-embed-section">
      <h2>Pick a time</h2>
      <div id="cal-inline" style="min-height:600px; border:1px solid var(--border); border-radius:var(--radius); overflow:hidden;"></div>
    </div>
  </div>

  <script>
    // Toggle between cards and inline embed
    // To switch to embed view, set SHOW_EMBED = true
    const SHOW_EMBED = false;
    const CAL_LINK = 'patcox/chat-with-pat'; // default event for embed

    if (SHOW_EMBED) {
      const cards = document.getElementById('schedule-cards');
      const embedSection = document.getElementById('cal-embed-section');
      if (cards) cards.style.display = 'none';
      if (embedSection) embedSection.style.display = 'block';

      const script = document.createElement('script');
      script.src = 'https://cal.com/embed.js';
      script.async = true;
      script.onload = () => {
        (window as any).Cal?.('inline', {
          elementOrSelector: '#cal-inline',
          calLink: CAL_LINK,
          config: { layout: 'month_view' },
        });
      };
      document.head.appendChild(script);
    }
  </script>

</Base>
