---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import { getCollection, getEntry } from 'astro:content';
import { SITE } from '../config/site.ts';
import patHeadshot from '../assets/pat-headshot.png';

const home = await getEntry('pages', 'home');
const { Content: HomeBio } = await home.render();
const { tagline, headline, newsletter_heading, newsletter_description } = home.data;

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);

function formatDate(d: Date) {
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
}
---
<Base
  title="Pat Cox"
  description={SITE.description}
>

  <!-- Hero / About -->
  <section class="hero">
    <div class="container">
      <div class="hero-grid">
        <div class="hero-content">
          <p class="hero-eyebrow">{tagline}</p>
          <h1>{headline}</h1>
          <div class="hero-bio">
            <HomeBio />
          </div>
          <div class="hero-actions">
            <a href="/connect" class="btn btn-primary">Connect with me</a>
            {SITE.showWriting && <a href="/writing" class="btn btn-outline">Read my writing</a>}
          </div>
        </div>
        <div class="headshot-wrap">
          <Image src={patHeadshot} alt="Pat Cox" width={280} format="webp" />
        </div>
      </div>
    </div>
  </section>

  <!-- Recent Writing (gated — flip SITE.showWriting to true when ready) -->
  {SITE.showWriting && posts.length > 0 && (
    <section class="section">
      <div class="container">
        <p class="section-label">Recent writing</p>
        <ul class="post-list">
          {posts.map(post => (
            <li>
              <a class="post-card" href={`/writing/${post.slug}`}>
                <div>
                  <span class="post-card-title">{post.data.title}</span>
                  {post.data.description && (
                    <p class="post-card-desc">{post.data.description}</p>
                  )}
                </div>
                <time class="post-card-date" datetime={post.data.pubDate.toISOString()}>
                  {formatDate(post.data.pubDate)}
                </time>
              </a>
            </li>
          ))}
        </ul>
        <p class="view-all"><a href="/writing">All posts →</a></p>
      </div>
    </section>
  )}

  <!-- Newsletter (gated — flip SITE.showNewsletter to true when ready) -->
  {SITE.showNewsletter && (
    <div class="newsletter-band">
      <div class="container">
        <h3>{newsletter_heading}</h3>
        <p>{newsletter_description}</p>
        <form class="newsletter-form" action="#" method="POST">
          <input type="email" name="email" placeholder="you@example.com" required />
          <button type="submit">Subscribe</button>
        </form>
      </div>
    </div>
  )}

</Base>
