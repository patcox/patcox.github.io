---
import Base from './Base.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  tags?: string[];
}

const { title, description, pubDate, tags = [] } = Astro.props;

const formatted = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---
<Base title={`${title} — Pat Cox`} description={description} article>
  <div class="container">
    <header class="post-header">
      <p class="section-label"><a href="/writing" style="color:var(--text-muted); text-decoration:none;">← Writing</a></p>
      <h1>{title}</h1>
      <div class="post-meta">
        <time datetime={pubDate.toISOString()}>{formatted}</time>
        {tags.length > 0 && (
          <div class="tags">
            {tags.map(t => <a href={`/tags/${t}`} class="tag">{t}</a>)}
          </div>
        )}
      </div>
    </header>

    <article class="post-body">
      <slot />
    </article>
  </div>
</Base>
